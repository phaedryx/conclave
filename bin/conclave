#!/bin/sh
# Runs exe/conclave with this repo's Ruby from any directory, so .mcp.json and Atelier can call it by absolute
# path. Resolves the Ruby binary through mise (which honors .ruby-version) rather than `mise exec`: in a shell
# where mise is already activated, `mise exec` leaves PATH as it found it, and a Homebrew Ruby listed earlier
# wins. exe/conclave requires bundler/setup itself, so no `bundle exec` is needed.
set -e

script=$0
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case $target in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
cd "$(dirname "$script")/.."

BUNDLE_GEMFILE=$PWD/Gemfile
export BUNDLE_GEMFILE

if command -v mise >/dev/null 2>&1; then
  ruby=$(mise which ruby)
else
  ruby=ruby
fi
exec "$ruby" exe/conclave "$@"
